PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/support_portal?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=replace-with-a-32-plus-character-secret
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_SECONDS=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=SupportHub <no-reply@example.com>

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

SUPPORT_NAME=Support Agent
SUPPORT_EMAIL=support@example.com
SUPPORT_PASSWORD=replace-with-a-strong-password
SUPPORT_ROLE=SUPPORT
